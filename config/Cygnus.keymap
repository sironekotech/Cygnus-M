#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 6 ESC       &lt 7 Q         &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &lt 3 I         &lt 7 O         &kp P           &kp BSPC
&kp TAB         &kp A           &kp S           &lt 3 D         &lt 7 F         &kp G           &mkp MCLK       &kp UP          &kp H           &kp J           &lt 3 K         &lt 4 L         &lt 5 RET       &kp RET
&kp LSHFT       &kp Z           &kp X           &kp C           &kp V           &kp B           &kp DEL         &kp DOWN        &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RSHFT
&kp LCTL        &kp LGUI        &kp LALT        &kp LANG5       &kp LGUI        &mt LALT LANG2  &mt LSHFT TAB   &lt 2 SPACE     &lt 1 LANG1     &kp DEL         &kp RCTL
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        SYMBOL {
            bindings = <
&trans               &kp N1               &kp N2               &kp N3               &kp N4               &kp N5               &kp N6               &kp N7               &kp N8               &kp N9               &kp N0               &trans
&trans               &mt LCTL EQUAL       &kp LBKT             &kp FSLH             &kp MINUS            &kp INT1             &trans               &trans               &kp SEMI             &kp SQT              &kp RBKT             &kp NON_US_HASH      &kp INT3             &trans
&trans               &kp LS(COMMA)        &kp LS(DOT)          &kp LS(FSLH)         &kp LS(MINUS)        &kp LS(INT1)         &trans               &trans               &kp LS(SEMI)         &kp LS(SQT)          &kp LS(RBKT)         &kp LS(NON_US_HASH)  &kp LS(INT3)         &trans
&trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
            >;
        };

        SHIFT_SYMBOL {
            bindings = <
&trans               &kp LS(N1)           &kp LS(N2)           &kp LS(N3)           &kp LS(N4)           &kp LS(N5)           &kp LS(N6)           &kp LS(N7)           &kp LS(N8)           &kp LS(N9)           &kp LG(INT3)         &trans
&trans               &kp LS(EQUAL)        &kp LS(LBKT)         &kp LS(FSLH)         &kp LS(MINUS)        &kp LS(INT1)         &trans               &trans               &kp LS(SEMI)         &kp LS(SQT)          &kp LS(RBKT)         &kp LS(NON_US_HASH)  &kp LS(INT3)         &trans
&trans               &kp LSHFT            &kp LGUI             &kp LALT             &none                &none                &trans               &trans               &kp SPACE            &kp LANG1            &trans               &trans               &kp DEL              &trans
&trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
            >;
        };

        NAV {
            bindings = <
&trans            &kp ESC           &kp LG(R)         &kp LG(K)         &kp LG(U)         &kp LG(Y)         &kp LG(SEMI)      &none             &kp UP            &none             &none             &trans
&trans            &kp LG(A)         &trans            &kp LS(FSLH)      &kp LS(N1)        &kp LG(Z)         &trans            &trans            &kp LG(KP_MINUS)  &kp LEFT          &kp DOWN          &kp RIGHT         &none             &trans
&trans            &kp LSHFT         &kp LGUI          &kp LG(C)         &kp LG(V)         &kp LG(S)         &trans            &trans            &none             &kp LANG1         &none             &none             &kp DEL           &trans
&trans            &trans            &trans            &trans            &trans            &kp LC(J)         &trans            &trans            &trans            &trans            &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans       &trans       &trans           &trans             &trans                         &kp LG(R)  &trans           &trans             &trans       &trans       &trans
&trans  &lt 5 SPACE  &mkp MB2     &mo 5            &mkp MB1           &mkp MB3   &mkp MB3    &trans  &mkp MB3   &mkp MB1         &mkp MB2           &lt 4 SPACE  &lt 5 SPACE  &trans
&trans  &trans       &trans       &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LG(R)  &trans      &trans  &trans     &mkp MB4         &mkp MB5           &trans       &trans       &trans
&trans  &trans       &trans       &trans           &trans             &trans     &trans      &trans  &trans                                                      &trans       &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans                       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans    &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &bt BT_CLR
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans                                                  &bt BT_CLR_ALL  &bt BT_CLR_ALL
            >;
        };

        FUNCTION {
            bindings = <
&trans             &kp LS(LG(LEFT))   &kp LS(LG(RIGHT))  &kp LC(LS(T))      &kp F5             &kp F12            &kp F2             &kp F3             &kp F4             &kp F5             &kp F6             &trans
&trans             &kp LG(LEFT)       &kp LG(RIGHT)      &kp LC(LA(U))      &kp LC(LA(I))      &kp F2             &trans             &trans             &kp F8             &kp F9             &kp F10            &kp F11            &kp F12            &trans
&trans             &kp LC(W)          &kp LC(T)          &kp LC(LA(J))      &kp LC(LA(K))      &trans             &trans             &trans             &trans             &trans             &none              &none              &none              &trans
&trans             &trans             &trans             &trans             &kp LC(LA(LEFT))   &kp LC(LA(RET))    &kp LC(LA(RIGHT))  &kp LS(LG(N4))     &kp LA(RIGHT)      &trans             &trans
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};
